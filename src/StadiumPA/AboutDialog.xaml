<Window x:Class="StadiumPA.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Stadium PA"
        SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <!-- Dark slider style (reused from MainWindow) -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Foreground" Value="#66AAEE"/>
            <Setter Property="Background" Value="#333333"/>
        </Style>

        <!-- Button style for file browsers -->
        <Style x:Key="BrowseButton" TargetType="Button">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <TabControl Background="#1E1E1E" BorderThickness="0" Margin="0">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Foreground" Value="#AAA"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </TabControl.Resources>

        <!-- About Tab -->
        <TabItem Header="About">
            <StackPanel Margin="24">
                <TextBlock Text="Stadium PA" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock x:Name="VersionText" FontSize="14" Foreground="#AAA"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Separator Background="#444444" Margin="0,0,0,16"/>

                <TextBlock Foreground="#CCC" FontSize="13" Margin="0,0,0,4">
                    Audio controller for lacrosse games.
                </TextBlock>
                <TextBlock Foreground="#CCC" FontSize="13" Margin="0,0,0,16">
                    Controls Spotify playback, local audio, and PA transitions.
                </TextBlock>

                <TextBlock Margin="0,0,0,8">
                    <Hyperlink x:Name="UsageLink" Foreground="#66AAEE" FontSize="13"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               NavigateUri="https://github.com/kurtzeborn/stadium-pa/blob/main/docs/USAGE.md">
                        📖 Usage Guide
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,0,0,16">
                    <Hyperlink x:Name="RepoLink" Foreground="#66AAEE" FontSize="13"
                               RequestNavigate="Hyperlink_RequestNavigate"
                               NavigateUri="https://github.com/kurtzeborn/stadium-pa">
                        🔗 GitHub Repository
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </TabItem>

        <!-- Settings Tab -->
        <TabItem Header="Settings">
            <StackPanel Margin="24">
                <!-- Audio Files -->
                <TextBlock Text="AUDIO FILES" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,12"/>
                
                <DockPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource BrowseButton}" Content="📂 Browse" DockPanel.Dock="Right"
                            Command="{Binding BrowseAnthemFileCommand}"
                            MinWidth="90" Margin="12,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="National Anthem:" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AnthemFileDisplay, Mode=OneWay}" 
                                   Foreground="#DDD" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,24">
                    <Button Style="{StaticResource BrowseButton}" Content="📂 Browse" DockPanel.Dock="Right"
                            Command="{Binding BrowseGoalFileCommand}"
                            MinWidth="90" Margin="12,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="Goal Celebration:" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GoalFileDisplay, Mode=OneWay}" 
                                   Foreground="#DDD" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <Separator Background="#444444" Margin="0,0,0,16"/>

                <!-- Audio Control Settings -->
                <TextBlock Text="AUDIO CONTROL" FontSize="13" FontWeight="Bold" Foreground="#888" Margin="0,0,0,12"/>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding DimLevelPercent}" Foreground="White" FontSize="13"
                               Width="45" TextAlignment="Right" VerticalAlignment="Center"
                               DockPanel.Dock="Right"/>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Dim Level:" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Slider Minimum="0.01" Maximum="0.50" SmallChange="0.01" LargeChange="0.05"
                                Value="{Binding DimLevel, Mode=TwoWay}"
                                Style="{StaticResource DarkSlider}"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding FadeDurationDisplay}" Foreground="White" FontSize="13"
                               Width="45" TextAlignment="Right" VerticalAlignment="Center"
                               DockPanel.Dock="Right"/>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Fade Duration:" Foreground="#AAA" FontSize="12" Margin="0,0,0,4"/>
                        <Slider Minimum="0.2" Maximum="3.0" SmallChange="0.1" LargeChange="0.5"
                                Value="{Binding FadeDurationSeconds, Mode=TwoWay}"
                                Style="{StaticResource DarkSlider}"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock Foreground="#777" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap">
                    💡 Tip: These settings are automatically saved and restored on next launch.
                </TextBlock>
            </StackPanel>
        </TabItem>
    </TabControl>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" 
                        Executed="CloseWindow_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
    </Window.InputBindings>
</Window>
